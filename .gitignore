# ============================================================

# SIH 26172 — Repository Git Ignore

# ============================================================

# ------------------------------------------------------------

# ESP-IDF / ESP32 build artifacts

# ------------------------------------------------------------

build/
sdkconfig.old
sdkconfig.*.old
dependencies.lock

# Keep the project's canonical sdkconfig if present.

# Uncomment the following only if sdkconfig should NOT be tracked:

# sdkconfig

# ESP-IDF generated files

managed_components/
components/*/build/
*.elf
*.bin
*.map
*.hex
*.uf2

# ------------------------------------------------------------

# Python

# ------------------------------------------------------------

**pycache**/
*.py[cod]
*$py.class

# Virtual environments

.venv/
.venv-*/
venv/
env/
ENV/

# Python tooling / caches

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Jupyter

.ipynb_checkpoints/

# ------------------------------------------------------------

# ML / experiment outputs

# ------------------------------------------------------------

# TensorFlow / Keras temporary files

*.keras.tmp
*.ckpt
*.ckpt.*
checkpoint
checkpoint.*

# TensorBoard

logs/
runs/

# Model outputs

# Keep model directories themselves trackable, but ignore large

# generated model binaries/checkpoints by default.

models/*.h5
models/*.hdf5
models/*.pb
models/*.tflite
models/*.onnx
models/*.ckpt*
models/saved_model/

# ------------------------------------------------------------

# Dataset — raw and generated data

# ------------------------------------------------------------

# Raw datasets are generally far too large for Git.

dataset/raw/

# Processed audio

dataset/processed/**/*.wav

# Generated feature arrays

dataset/processed/**/*.npy
dataset/processed/**/*.npz

# Generated feature caches

dataset/processed/features/

# Dataset/debug artifacts

dataset/debug/

# Dataset metadata/manifests that are intentionally generated

# should be reviewed before committing. Keep CSV/TSV tracked by

# default unless explicitly ignored elsewhere.

# ------------------------------------------------------------

# Large local archives / downloads

# ------------------------------------------------------------

*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Audio/video downloaded locally

*.mp3
*.flac
*.ogg
*.m4a
*.aac

# ------------------------------------------------------------

# Local experiment output

# ------------------------------------------------------------

*.log
*.out
*.tmp
*.temp

# Benchmark dumps

benchmark_results/
experiment_results/

# ------------------------------------------------------------

# OS files

# ------------------------------------------------------------

.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# ------------------------------------------------------------

# Editor / IDE

# ------------------------------------------------------------

.vscode/
.idea/
*.swp
*.swo
*~

# Visual Studio

.vs/
*.user
*.suo
*.VC.db

# ------------------------------------------------------------

# Windows

# ------------------------------------------------------------

*.lnk

# ------------------------------------------------------------

# Secrets / local configuration

# ------------------------------------------------------------

.env
.env.*
!.env.example

# Credentials / keys

*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json

# ------------------------------------------------------------

# Local tooling

# ------------------------------------------------------------

*.egg-info/
dist/
wheelhouse/

# ------------------------------------------------------------

# Agent / local scratch files

# ------------------------------------------------------------

.agent/
.agents/
.claude/
.cursor/
.copilot/
.tmp/
scratch/
scratchpad/

# ------------------------------------------------------------

# Explicit local-only files

# ------------------------------------------------------------

# Add machine-specific files here rather than committing them.

# Example:

# local_config.json

# local_settings.py

# hardware_notes.local.md
